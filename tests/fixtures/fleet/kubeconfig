# A kubeconfig for scripted runs.
#
# The servers are in the RFC 5737 documentation range, which routes nowhere, so
# a run that tries to connect fails immediately rather than reaching a real
# cluster. The credentials are obvious placeholders for the same reason.
#
# Three contexts, chosen to cover what the screen has to render:
#   fixture-dev      an ordinary context
#   fixture-staging  the current context, with a non-default namespace
#   fixture-broken   names a cluster this file does not define
apiVersion: v1
kind: Config
current-context: fixture-staging

clusters:
  - name: fixture-dev-cluster
    cluster:
      server: https://192.0.2.10:6443
      insecure-skip-tls-verify: true
  - name: fixture-staging-cluster
    cluster:
      server: https://192.0.2.11:6443
      insecure-skip-tls-verify: true

users:
  - name: fixture-user
    user:
      token: not-a-real-token

contexts:
  - name: fixture-dev
    context:
      cluster: fixture-dev-cluster
      user: fixture-user
      namespace: default
  - name: fixture-staging
    context:
      cluster: fixture-staging-cluster
      user: fixture-user
      namespace: apps
  - name: fixture-broken
    context:
      cluster: fixture-cluster-that-is-not-defined
      user: fixture-user
